{
  "name": "viewprobe",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless layout verification engine for AI coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "viewprobe": "dist/cli.js",
    "viewprobe-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp-server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "layout", "css", "verification", "ai-agents", "mcp",
    "responsive", "headless", "testing", "developer-tools"
  ],
  "author": "Umang Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umang-sudo-su/ViewProbe.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
